{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "wrangler d1 execute plantopia-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute plantopia-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute plantopia-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute plantopia-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.122.0"
  }
}
